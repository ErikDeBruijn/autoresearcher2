#!/usr/bin/env python3
"""Create a new research project via the AutoResearcher2 API."""
import argparse
import json
import sys
import urllib.request

API = "http://localhost:8000"

_DEFAULT_DOMAIN_CONFIG = {
    "name": "research experiment",
    "description": "We run experiments to optimize a target metric.",
    "intervention_types": "config_change, probe, code_change",
    "parameters": "any key-value pairs relevant to the domain",
}

def main():
    parser = argparse.ArgumentParser(description="Create a research project")
    parser.add_argument("--name", required=True, help="Project name")
    parser.add_argument("--description", default="", help="Project description")
    parser.add_argument("--domain", default="generic", help="Domain type label")
    parser.add_argument("--parameters", default=None, help="Comma-separated parameter names")
    parser.add_argument("--target-metric", default=None, help="Primary metric to optimize (e.g. taste_score, val_bpb)")
    parser.add_argument("--optimize", default=None, choices=["minimize", "maximize"], help="Optimization direction")
    args = parser.parse_args()

    domain_cfg = dict(_DEFAULT_DOMAIN_CONFIG)
    if args.parameters:
        domain_cfg["parameters"] = args.parameters
    if args.target_metric:
        domain_cfg["target_metric"] = args.target_metric
    if args.optimize:
        domain_cfg["optimize"] = args.optimize

    body = json.dumps({
        "name": args.name,
        "description": args.description,
        "domain_config": domain_cfg,
    }).encode()

    req = urllib.request.Request(
        f"{API}/api/projects",
        data=body,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            result = json.loads(resp.read())
            print(json.dumps(result, indent=2))
    except urllib.error.HTTPError as e:
        print(f"Error {e.code}: {e.read().decode()}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
